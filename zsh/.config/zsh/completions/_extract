#compdef extract
# vim: set et ft=zsh sw=2 sts=2 ts=2 tw=100:

_arguments -A '-*' \
  '(- *)'{-h,--help}'[Show usage]' \
  '(-r --remove)'{-r,--remove}'[Remove each archive after successful extraction]' \
  '*:archive:_files -g "*.(7z|Z|bz2|deb|gz|lzma|rar|tar|tbz|tbz2|tgz|tlz|txz|tzst|xz|zip|zst|zstd)(-.)"'
