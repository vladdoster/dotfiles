#compdef mkrepeat

local name_spec='1:new function name:'
(( ${words[(I)(-f|--force)]} )) && name_spec='1:function to replace:_functions'

_arguments -A '-*' \
  '(-f --force)'{-f,--force}'[Replace an existing name or function file]' \
  '(-h --help)'{-h,--help}'[Show usage]' \
  '(-w --write)'{-w,--write}'[Also save the function in $ZDOTDIR/functions]' \
  $name_spec \
  '*:::command:_normal'

