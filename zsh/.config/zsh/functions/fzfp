#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# fzf with a file preview bound to ?.

emulate -L zsh

fzf --ansi --bind '?:toggle-preview' --inline-info --reverse --tabstop=1 --preview='
  [[ $(file --mime {}) =~ binary ]] \
  && echo {} is a binary file \
  || highlight --style base16/nord -O ansi -l {} \
  || head -500 {} 2> /dev/null'
