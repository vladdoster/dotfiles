#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Shared implementation behind wezterm::send-pane and wezterm::bring-pane.
#
#   wezterm::_pane <send|bring> <direction> <stay 0|1> <list 0|1> [tab-title|tab-id]
#
# The two differ only in which pane moves into which: sending moves this pane into the
# target tab, bringing moves the target tab's active pane here. Options and help text
# stay with the public functions, so each keeps its own name in messages and usage.

emulate -L zsh
setopt typeset_silent

# messages name the public function the user actually called
local self=${funcstack[2]:-$0}

local mode=$1 direction=$2
integer stay=$3 list=$4
shift 4

((!$+commands[wezterm])) && { log::error "${self}: wezterm command not found"; return 1 }
((!$+commands[jq])) && { log::error "${self}: jq command not found"; return 1 }

[[ -z ${WEZTERM_PANE} ]] && {
  log::error "${self}: not inside WezTerm (WEZTERM_PANE is unset)"
  return 1
}

(($# > 1)) && {
  log::error "${self}: expected one tab title or id (quote titles containing spaces)"
  return 1
}

local json
json="$(command wezterm cli --no-auto-start list --format=json)" || {
  log::error "${self}: failed to query the wezterm mux"
  return 1
}

if ((list)) || ((!$#)); then
  builtin print -P -- '%F{green}==>%f tabs (* = current):'
  command jq --raw-output --argjson current "${WEZTERM_PANE}" '
    group_by(.tab_id)[]
    | [ (if any(.[]; .pane_id == $current) then "*" else " " end),
        ("w" + (.[0].window_id | tostring)),
        ("t" + (.[0].tab_id | tostring)),
        (if .[0].tab_title == "" then "(untitled)" else .[0].tab_title end),
        ([.[].title] | join(", ")) ]
    | join("  ")
  ' <<< "${json}"
  return 0
fi

local -a info
info=("${(@f)$(command jq --raw-output --arg title "$1" --argjson current "${WEZTERM_PANE}" '
  ( [.[] | select(.pane_id == $current)][0].tab_id ) as $current_tab
  | ( [.[] | select(.tab_title == $title).tab_id] | unique ) as $title_matches
  | ( if ($title_matches | length) == 0 and ($title | test("^[0-9]+$"))
      then [.[] | select((.tab_id | tostring) == $title).tab_id] | unique
      else $title_matches
      end ) as $all_matches
  | ( [$all_matches[] | select(. != $current_tab)] ) as $matches
  | ( $matches | first ) as $target_tab
  | ( [.[] | select(.tab_id == $target_tab)]
      | (map(select(.is_active)) + .)[0].pane_id ) as $target_pane
  | $current_tab, ($all_matches | length), ($matches | length), $target_tab, $target_pane,
    ( group_by(.tab_id) | map(
        (.[0].tab_id | tostring) + ":" +
        (if .[0].tab_title == "" then "[" + ((map(select(.is_active)) + .)[0].title) + "]"
         else .[0].tab_title end)
      ) | join(", ") )
' <<< "${json}")}") || return 1

local current_tab=${info[1]} all_matches=${info[2]} matches=${info[3]} \
  target_tab=${info[4]} target_pane=${info[5]} tabs=${info[6]}

[[ ${current_tab} == null ]] && {
  log::error "${self}: pane ${WEZTERM_PANE} not found in this wezterm mux"
  return 1
}

((all_matches == 0)) && {
  log::error "${self}: no tab matching '${1}'"
  builtin print -P -- "%F{green}==>%f tabs: ${tabs}"
  builtin print -P -- "%F{green}==>%f target a tab id, or title tabs with: wezterm cli set-tab-title <title>"
  return 1
}

((matches == 0)) && { log::error "${self}: tab '${1}' is the current tab"; return 1 }

((matches > 1)) \
  && builtin print -P -- "%F{yellow}Warning:%f ${matches} tabs match '${1}'; using tab ${target_tab}"

local -a split=(command wezterm cli --no-auto-start split-pane ${direction})

if [[ ${mode} == send ]]; then
  split+=(--pane-id ${target_pane} --move-pane-id ${WEZTERM_PANE})
else
  split+=(--pane-id ${WEZTERM_PANE} --move-pane-id ${target_pane})
fi

$split > /dev/null || { log::error "${self}: wezterm cli split-pane failed"; return 1 }

if [[ ${mode} == send ]]; then
  if ((stay)); then
    command wezterm cli --no-auto-start activate-tab --tab-id "${current_tab}" 2> /dev/null
  else
    command wezterm cli --no-auto-start activate-pane --pane-id "${WEZTERM_PANE}"
  fi
  builtin print -P -- "%F{green}==>%f sent pane ${WEZTERM_PANE} to tab '${1}' (tab ${target_tab})"
else
  builtin print -P -- "%F{green}==>%f brought pane ${target_pane} from tab '${1}' (tab ${target_tab})"
fi
