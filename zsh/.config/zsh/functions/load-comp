#autoload
# vim: set et ft=zsh sw=2 sts=2 ts=2 tw=100:
#
# Load the zsh completion of one or more tools by running each tool's own completion command.
#
# Without --command, the function tries each common form in order. It keeps a script only if
# the script is for zsh: gh prints a bash script for `completion zsh` and still exits 0. The
# script is captured first because `source <(cmd)` returns the status of source, which
# succeeds on the empty file a failing command leaves behind. If no form works, the function
# falls back to _gnu_generic.

builtin emulate -L zsh -o EXTENDED_GLOB
zmodload zsh/zutil || return 1

local -a opt_help opt_debug opt_quiet opt_command
builtin zparseopts -D -E -F -K -- \
  {h,-help}=opt_help \
  {d,-debug}=opt_debug \
  {q,-quiet}=opt_quiet \
  {c,-command}:=opt_command \
  || return 1

if (( $#opt_help )); then
  print -r -- "Usage: $0 [options] <command>..."
  print -r -- 'Options:'
  print -r -- '  -c, --command ARGS  run "command ARGS" to print the zsh completion script'
  print -r -- '  -d, --debug         turn on execution tracing'
  print -r -- '  -h, --help          show list of command-line options'
  print -r -- '  -q, --quiet         do not report loaded completions'
  return 0
fi

(( $#opt_debug )) && setopt xtrace

if (( ! $# )); then
  log::error "$0 requires one or more command names"
  return 1
fi

# zparseopts keeps the = of --command=ARGS in the value
(( $#opt_command )) && opt_command[-1]=${opt_command[-1]#=}

if (( $#opt_command )) && [[ -z $opt_command[-1] ]]; then
  log::error "$0: --command requires a non-empty argument string"
  return 1
fi

if (( ! $+functions[compdef] )); then
  log::error "$0: compdef is not loaded (run compinit first)"
  return 1
fi

local -a forms
if (( $#opt_command )); then
  forms=($opt_command[-1])
else
  forms=(
    'completion --shell zsh'
    'completion -s zsh'
    'completion zsh'
    'completions zsh'
    'completions'
    'complete --shell zsh'
    '--completion zsh'
    '--generate-completion zsh'
    '--gen-completions zsh'
    '--generate complete-zsh'
    'generate-shell-completion zsh'
    'gen-completion zsh'
  )
fi

local cmd form script func
local -a words
integer stat=0

for cmd in "$@"; do
  if (( ! $+commands[$cmd] )); then
    log::error "$0: command not found: ${(qq)cmd}"
    stat=1
    continue
  fi

  for form in $forms; do
    words=(${(Q)${(z)form}})
    script=$(command $cmd $words 2>/dev/null </dev/null) || continue
    # Accept zsh completion code only. A bash script has neither marker.
    [[ $script == (#s)\#compdef* || $script == *$'\n'compdef\ _* ]] && break
  done

  if [[ $script != (#s)\#compdef* && $script != *$'\n'compdef\ _* ]]; then
    # No form printed a zsh script. _gnu_generic reads the options from `$cmd --help`.
    compdef _gnu_generic $cmd
    (( $#opt_quiet )) \
      || log::info "$0: loaded $cmd completion with _gnu_generic (no zsh script found, try --command)"
    continue
  fi

  if [[ $script == (#s)\#compdef* ]]; then
    # A #compdef script is a completion file body. Load it as compinit does.
    functions[_$cmd]=$script
    compdef _$cmd $cmd
  else
    # The exit status of the script is not a load signal. Some scripts end with a call
    # that fails outside completion. The compdef check below is the real test.
    builtin eval "$script"

    # Most scripts register themselves. The explicit compdef covers the ones that do not.
    if (( ! $+_comps[$cmd] )); then
      for func in _$cmd _complete_$cmd; do
        (( $+functions[$func] )) && break
        func=
      done
      if [[ -z $func ]]; then
        log::error "$0: ${(qq)cmd} completion script did not register $cmd"
        stat=1
        continue
      fi
      compdef $func $cmd
    fi
  fi
  (( $#opt_quiet )) || log::info "$0: loaded $cmd completion"
done

return $stat
