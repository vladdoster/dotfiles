#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Browse the git log with fzf; preview a commit, or press enter to page it.

emulate -L zsh
setopt extendedglob

if ! command git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log::error "$0: not a git repository: ${(D)PWD}"
    return 1
fi

# the graph column precedes the hash, so pull the first hash out of the selected line
local hash='$(printf %s {} | grep -oE "[a-f0-9]{7,}" | head -1)'

command git log --color=always --graph \
    --format='%C(auto)%h%d %s %C(black)%C(bold)%cr' "$@" |
    fzf --ansi \
        --preview "git show --color=always $hash" \
        --bind "enter:execute:git show --color=always $hash | less -R"
