#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Put keg-only homebrew formulae and GNU tool directories on $PATH.
#
# Entries are added through the path array, which .zprofile declares -U, so repeated
# calls cannot accumulate duplicates.

emulate -L zsh
setopt extendedglob
zmodload zsh/zutil || return 1

local -a opt_all opt_debug opt_help
builtin zparseopts -D -E -F -K -- \
    {a,-all}=opt_all \
    {d,-debug}=opt_debug \
    {h,-help}=opt_help \
    || return 1

if (( $#opt_help )); then
    print -r -- "Usage: $0 [options] [keg-pattern ...]"
    print -r -- 'Options:'
    print -r -- '  -a, --all          add all unlinked kegs found'
    print -r -- '  -d, --debug        turn on execution tracing'
    print -r -- '  -h, --help         show list of command-line options'
    return 0
fi

(( $#opt_debug )) && setopt xtrace

(( $+commands[brew] )) || { log::error "$0 requires brew"; return 1 }
(( $+commands[jq] )) || { log::error "$0 requires jq"; return 1 }

local -a patterns=("$@")
(( $#opt_all || ! $#patterns )) && patterns=('*')

local prefix=${commands[brew]:h:h}
local pat keg util name

# --raw-output already prints one name per line; @sh only added quotes to strip again
local -a keg_only=(${(f)"$(command brew info --installed --json=v1 |
    command jq --raw-output 'map(select(.keg_only == true)) | .[].name')"})

local -a selected=()

for pat in $patterns; do
    selected+=(${(M)keg_only:#*${~pat}*})
done

for keg in ${(uo)selected}; do
    path=($prefix/opt/$keg/bin $path)
    print -P -- "%F{green}==>%f [+] ${keg}"
done

local -a gnu_prefixes=(/opt/homebrew/opt /usr/local/opt)
local -a gnubins=(${^gnu_prefixes}/*/libexec/gnubin(N/))

selected=()

for pat in $patterns; do
    selected+=(${(M)gnubins:#*${~pat}*})
done

for util in ${(uo)selected}; do
    name=${${util:h:h}:t}
    path=($util $path)
    print -P -- "%F{green}==>%f [+] ${name}"
done
