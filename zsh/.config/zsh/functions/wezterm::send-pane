#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Send the current pane to another tab as a split.

emulate -L zsh
setopt typeset_silent
zmodload zsh/zutil || return 1

local -a debug direction help list stay

zparseopts -D -F -K -- \
  {d,-debug}=debug \
  {h,-help}=help \
  {l,-list}=list \
  {s,-stay}=stay \
  {-left,-right,-top,-bottom}=direction \
  || return 1

((${#debug})) && setopt xtrace

if ((${#help})); then
  print -r -- "Usage: $0 [options] <tab-title|tab-id>"
  print -r -- 'Send the current pane to the given tab as a split (default: right).'
  print -r -- 'The target is an exact tab title (takes precedence) or a numeric tab id.'
  print -r -- 'Options:'
  print -r -- '  -d, --debug            turn on execution tracing'
  print -r -- '  -h, --help             show list of command-line options'
  print -r -- '  -l, --list             list tabs (also the default with no arguments)'
  print -r -- '  -s, --stay             keep focus here instead of following the pane'
  print -r -- '  --left, --right, --top, --bottom'
  print -r -- "                         side of the target tab's active pane for the split"
  print -r -- 'Title a tab with: wezterm cli set-tab-title <title>'
  return 0
fi

((${#direction} > 1)) && {
  log::error "$0: pick one of --left/--right/--top/--bottom, got: ${direction}"
  return 1
}
((${#direction})) || direction=(--right)

autoload -Uz wezterm::_pane

wezterm::_pane send ${direction[1]} ${#stay} ${#list} "$@"
