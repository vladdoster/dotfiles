#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Print a progress message to stdout.
#
# Callers pass prompt escapes on purpose -- rc.d/05-zinit.zsh highlights paths with
# %B...%b -- so the message is prompt expanded on a terminal. When stdout is a file or a
# pipe the markup is stripped instead, which keeps logs readable without emitting escape
# sequences. Gating on the destination rather than on interactivity means messages still
# appear under make, launchd, cron and ssh.

builtin emulate -L zsh -o EXTENDED_GLOB

local msg=${*}

if [[ -t 1 ]]; then
    print -P -- "%F{green}==>%f %F{white}${msg}%f"
else
    msg=${msg//\%[FK]\{[^\}]##\}/}
    msg=${msg//\%[BbUuSsfk]/}
    print -r -- "==> ${msg//\%\%/%}"
fi
