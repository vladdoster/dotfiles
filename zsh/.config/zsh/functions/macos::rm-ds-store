#autoload
# vim: set et ft=zsh sw=2 sts=2 ts=2 tw=100:
#
# Delete every .DS_Store below $HOME, skipping Trash and Library.

builtin emulate -L zsh

# any argument stops here, so a mistyped option cannot start the delete
if (( $# )); then
  if [[ $1 == (-h|--help) ]]; then
    print -r -- "Usage: $0 [-h|--help]"
    return 0
  fi
  log::error "$0: unexpected argument: $1"
  return 1
fi

# -delete forces a depth-first walk, and find ignores -prune then. -exec keeps the prune.
command find \
  $HOME \
  -type d \( -path $HOME/.Trash -o -path $HOME/Library \) \
  -prune \
  -o \
  -name '.DS_Store' \
  -print \
  -exec rm -f -- {} +
