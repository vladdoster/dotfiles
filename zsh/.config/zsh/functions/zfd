#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Edit zsh function files, or the matching completion files with -c.
#
# With no arguments, cd to the functions directory instead.

emulate -LR zsh
setopt extendedglob typeset_silent
zmodload zsh/zutil || return 1

local -a opt_completion opt_debug opt_help
zparseopts -D -F -K -- \
    {c,-completion}=opt_completion \
    {d,-debug}=opt_debug \
    {h,-help}=opt_help \
    || return 1

if (( $#opt_help )); then
    print -r -- "Usage: $0 [options] [function ...]"
    print -r -- 'Options:'
    print -r -- '  -c, --completion       edit completion definitions'
    print -r -- '  -d, --debug            turn on execution tracing'
    print -r -- '  -h, --help             show list of command-line options'
    return 0
fi

(( $#opt_debug )) && setopt xtrace

local base=${ZDOTDIR:-$HOME/.config/zsh}

if (( ! $# )); then
    builtin cd -- $base/functions
    return
fi

if (( $#opt_completion )); then
    ${EDITOR:-vi} -O -- $base/completions/_${^@}
else
    ${EDITOR:-vi} -O -- $base/functions/${^@}
fi
