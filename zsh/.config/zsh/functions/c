#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# cd to a project below ~/code and list it.

emulate -L zsh
setopt extendedglob
zmodload zsh/zutil || return 1

local -a opt_help opt_debug
zparseopts -D -F -K -- {h,-help}=opt_help {d,-debug}=opt_debug || return 1

if (( $#opt_help )); then
    print -r -- "Usage: $0 [-h|--help] [-d|--debug] [directory]"
    print -r -- 'Options:'
    print -r -- '  -d, --debug        turn on execution tracing'
    print -r -- '  -h, --help         show list of command-line options'
    return 0
fi

(( $#opt_debug )) && setopt xtrace

if (( $# > 1 )); then
    log::error "$0 expects at most one argument, got $#: ${(j:, :)@}"
    return 1
fi

local dest=$HOME/code/$1

if [[ ! -d $dest ]]; then
    log::error "$0: no such directory: ${(D)dest}"
    return 1
fi

builtin cd -- $dest && command ls -A
