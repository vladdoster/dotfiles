#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Copy each argument to <name>.bak.

emulate -L zsh
setopt extendedglob
zmodload zsh/zutil || return 1

local -a opt_help
zparseopts -D -F -K -- {h,-help}=opt_help || return 1

if (( $#opt_help )); then
    print -r -- "Usage: $0 [-h|--help]"
    print -r -- "       $0 [filenames...]"
    return 0
fi

if (( ! $# )); then
    log::error "$0 requires one or more arguments"
    return 1
fi

local f
integer stat=0

for f in "$@"; do
    if command cp -- $f $f.bak; then
        log::info "$f.bak created"
    else
        stat=1
    fi
done

return $stat
