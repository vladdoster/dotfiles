#autoload
# vim: set et ft=zsh sw=2 sts=2 ts=2 tw=100:
#
# Pick a dotfile with fzf and open it in $EDITOR.

emulate -L zsh
setopt extendedglob

local -a files=(${DOTFILES:-$HOME/.config/dotfiles}/(^.git/)#*(.ND))

if (( ! $#files )); then
  log::error "$0: no files below ${(D)${DOTFILES:-$HOME/.config/dotfiles}}"
  return 1
fi

local choice=$(print -rl -- $files | fzfp)

[[ -n $choice ]] || return 1

edit::file $choice
