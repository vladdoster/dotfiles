#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Print an error message to stderr.
#
# An error must be visible wherever it happens, including under make, launchd, cron and
# ssh -- gating on interactivity meant scripted runs failed silently and still exited 0.
# Test the destination rather than the shell: colour only when stderr is a terminal.
# Only the prefix is prompt expanded, so a % in a path or a filename is printed as is.

builtin emulate -L zsh -o EXTENDED_GLOB

local prefix='Error:'

[[ -t 2 ]] && prefix=${(%):-'%F{red}Error:%f'}

print -r -- "${prefix} ${*}" >&2
