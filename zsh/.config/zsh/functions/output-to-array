#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Slurp piped stdin into an array, one element per line.
#
# The locals are prefixed so that the caller can ask for an array by any ordinary name
# without it colliding with a variable used here.

builtin emulate -L zsh -o EXTENDED_GLOB

local -a _o2a_help
local -a _o2a_usage=(
  "output-to-array [-h|--help] [array-name]"
  ""
  "Read stdin and split it on newlines into the named array (default: lines)."
  "Example: print -l -- /etc/hosts | output-to-array hosts && print -l -- \$hosts"
)

zmodload zsh/zutil || return 1
zparseopts -D -F -K -- {h,-help}=_o2a_help || return 1

(( $#_o2a_help )) && { builtin print -rl -- "$_o2a_usage[@]"; return 0; }

if (( $# > 1 )); then
  log::error "$0: at most one array name allowed"
  return 1
fi

local _o2a_name=${1:-lines}

if [[ $_o2a_name != [A-Za-z_][A-Za-z0-9_]# ]]; then
  log::error "$0: ${(qq)_o2a_name} is not a valid array name"
  return 1
fi

if [[ -t 0 ]]; then
  log::error "$0: no input; pipe data into this function"
  return 1
fi

local _o2a_input

IFS= read -rd '' _o2a_input

# the trailing newline would otherwise become a final empty element
set -A $_o2a_name "${(@f)_o2a_input%$'\n'}"
