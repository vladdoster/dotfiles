#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Print a text emoji, optionally copying it to the clipboard.

emulate -L zsh
setopt extendedglob
zmodload zsh/zutil || return 1

local -a flag_copy flag_help flag_print
zparseopts -D -E -F -K -- \
    {c,-copy}=flag_copy \
    {h,-help}=flag_help \
    {p,-print}=flag_print \
    || return 1

local -A emojis=(
    disappointed 'ಠ_ಠ'
    flip '（╯°□°）╯ ┻━┻'
    shrug '¯\_(ツ)_/¯'
)

if (( $#flag_help )); then
    print -r -- 'Usage:'
    print -r -- "  $0 <options> [${(kj:|:)emojis}]"
    print -r --
    print -r -- 'Options:'
    print -r -- '  -c, --copy    Copy the emoji to the clipboard'
    print -r -- '  -h, --help    Show this help message'
    print -r -- '  -p, --print   Print the emoji (default)'
    return 0
fi

if (( $# > 1 )); then
    log::error "$0: only one emoji may be given"
    return 1
fi

if (( ! $# )); then
    log::error "$0 requires an emoji name"
    return 1
fi

if (( ! $+emojis[$1] )); then
    log::error "$0: unknown emoji: $1"
    print -u2 -r -- "valid emojis: ${(kj:, :)emojis}"
    return 1
fi

if (( $#flag_copy )); then
    print -nr -- $emojis[$1] | pbcopy -pboard general || return 1
    print -r -- "$0: $1 copied to clipboard"
else
    print -nr -- $emojis[$1]
fi
