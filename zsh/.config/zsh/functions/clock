#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Show a clock that redraws in place once a second.
#
# zsh/datetime formats the time, zsh/zselect waits and zsh/terminfo moves the cursor, so
# the loop runs without starting date, sleep or tput every second.

emulate -L zsh
zmodload zsh/datetime || return 1
zmodload zsh/terminfo || return 1
zmodload zsh/zselect || return 1

print -r -- '==> initialising clock'

while true; do
    print -r -- '=========='
    strftime '%r' $EPOCHSECONDS
    print -r -- '=========='
    zselect -t 100
    repeat 3; do
        echoti cuu1
        echoti el
    done
done
