#autoload
# vim: set et ft=zsh sw=2 sts=2 ts=2 tw=100:
#
# Extract one or more archives, optionally removing each one afterwards.
#
# Returns non-zero if any archive failed, so a caller can tell what happened.

emulate -L zsh
setopt extendedglob pipefail

integer remove=0

if [[ $1 == (-h|--help) ]]; then
  print -r -- "Usage: $0 [-r|--remove] [file ...]"
  print -r --
  print -r -- 'Options:'
  print -r -- '    -h, --help   : Show this message.'
  print -r -- '    -r, --remove : Remove archive.'
  return 0
fi

if [[ $1 == (-r|--remove) ]]; then
  remove=1
  shift
fi

if (( ! $# )); then
  print -u2 -r -- "Usage: $0 [-h|--help] [-r|--remove] [file ...]"
  return 1
fi

local dir archive
integer stat=0 failed

while (( $# )); do
  if [[ ! -f $1 ]]; then
    log::error "$0: not a valid file: $1"
    stat=1
    shift
    continue
  fi

  dir=${${1:t}%.*}
  failed=0

  case $1 in
    (*.tar.gz|*.tgz) command tar xvzf $1 || failed=1 ;;
    (*.tar.bz2|*.tbz|*.tbz2) command tar xvjf $1 || failed=1 ;;
    (*.tar.xz|*.txz)
      if command tar --xz --help &>/dev/null; then
        command tar --xz -xvf $1 || failed=1
      else
        command xzcat $1 | command tar xvf - || failed=1
      fi
      ;;
    (*.tar.lzma|*.tlz)
      if command tar --lzma --help &>/dev/null; then
        command tar --lzma -xvf $1 || failed=1
      else
        command lzcat $1 | command tar xvf - || failed=1
      fi
      ;;
    # tar detects zstd itself; bsdtar reads -I as an include file, not a filter
    (*.tar.zst|*.tar.zstd|*.tzst) command tar xvf $1 || failed=1 ;;
    (*.tar) command tar xvf $1 || failed=1 ;;
    # -k and -c keep the archive; only -r removes it
    (*.gz) command gunzip -k -- $1 || failed=1 ;;
    (*.bz2) command bunzip2 -k -- $1 || failed=1 ;;
    (*.xz) command unxz -k -- $1 || failed=1 ;;
    (*.lzma) command unlzma -k -- $1 || failed=1 ;;
    (*.Z) command uncompress -c -- $1 > ${1%.Z} || failed=1 ;;
    (*.zst)
      if (( $+commands[zstd] )); then
        command zstd -d -- $1 || failed=1
      else
        log::error "$0: zstd not found: $1"
        failed=1
      fi
      ;;
    (*.zip) command unzip $1 -d $dir || failed=1 ;;
    (*.rar) command unrar e -ad $1 || failed=1 ;;
    (*.7z) command 7za x $1 || failed=1 ;;
    (*.deb)
      # the archive path must be resolved before descending into $dir
      archive=${1:A}
      command mkdir -p $dir/control $dir/data || failed=1
      if (( ! failed )); then
        pushd -q $dir || failed=1
      fi
      if (( ! failed )); then
        {
          # members may be .gz, .xz or .zst, so let tar detect the compression
          command ar vx $archive >/dev/null &&
            command tar xvf control.tar.*(N[1]) -C control &&
            command tar xvf data.tar.*(N[1]) -C data &&
            command rm -f -- control.tar.*(N) data.tar.*(N) debian-binary(N) || failed=1
        } always {
          popd -q
        }
      fi
      ;;
    (*)
      log::error "$0: cannot be extracted: $1"
      failed=1
      ;;
  esac

  if (( failed )); then
    stat=1
  elif (( remove )); then
    command rm -f -- $1 || stat=1
  fi

  shift
done

return $stat
