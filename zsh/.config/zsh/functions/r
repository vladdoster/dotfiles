#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Reload every autoloaded function from $ZDOTDIR/functions.

emulate -LR zsh
setopt extendedglob typeset_silent

zmodload zsh/zutil || return 1

local -a opt_debug opt_help opt_trace
zparseopts -D -E -F -K -- {d,-debug}=opt_debug {h,-help}=opt_help {t,-trace}=opt_trace || return 1

if (( $#opt_help )); then
    print -r -- "Usage: $0 [options]"
    print -r -- 'Options:'
    print -r -- '  -d, --debug       enables debug mode'
    print -r -- '  -h, --help        show list of command-line options'
    print -r -- '  -t, --trace       autoload functions with tracing'
    return 0
fi

if (( $#opt_debug )); then
    local PS4='
  \n[%B+%i%b] '
    setopt xtrace
fi

local -a fns=(${ZDOTDIR:-$HOME/.config/zsh}/functions/*(N.:t))

(( $#fns )) || return 0

unfunction $fns 2>/dev/null
builtin autoload -Uz ${opt_trace:+-T} -- $fns
