#autoload
# vim: ft=zsh sw=2 ts=2 et

v() {
  emulate -L zsh

  zmodload zsh/zutil || return

  setopt typeset_silent
  local debug editor help

  zparseopts -D -F -K -F -- \
    {d,-debug}=debug \
    {h,-help}=help   \
  || return 1

  if (( ${#debug} )); then
    setopt xtrace
  fi

  if (( ${#help} )); then
    print "Usage: $0 [options] [files...]"
    print 'Options:'
    print '  -d, --debug            turn on execution tracing'
    print '  -h, --help             show list of command-line options'
    return 0
  fi

  # $EDITOR is resolved once to an absolute binary in rc.d/00-env.zsh
  editor="${EDITOR:-vim}"
  if (( ${#debug} )); then
    print -- "${editor}" "${@}"
  else
    "${editor}" "${@}"
  fi
}

v "$@"
