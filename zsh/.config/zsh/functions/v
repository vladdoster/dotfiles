#autoload
# vim: set et:ft=zsh:sw=2:st=2:ts=2:tw=100:
#
# Open files in $EDITOR.

emulate -L zsh
setopt typeset_silent
zmodload zsh/zutil || return 1

local -a debug help

zparseopts -D -F -K -- \
  {d,-debug}=debug \
  {h,-help}=help \
  || return 1

if (( $#help )); then
  print -r -- "Usage: $0 [options] [files...]"
  print -r -- 'Options:'
  print -r -- '  -d, --debug            turn on execution tracing'
  print -r -- '  -h, --help             show list of command-line options'
  return 0
fi

# $EDITOR is resolved once to an absolute binary in rc.d/00-env.zsh
if (( $#debug )); then
  print -r -- $EDITOR "$@"
else
  $EDITOR "$@"
fi
